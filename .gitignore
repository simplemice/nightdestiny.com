# Ignore everything by default
*

# Git control files
!.gitignore
!.gitattributes
!.github/

# ---- Website files (allow-list) ----
!CNAME
!index.html
!404.html
!robots.txt
!sitemap.xml

!css/
!css/*.css

!js/
!js/*.js

!assets/
!assets/favicon.svg
!assets/favicon.ico
!assets/apple-touch-icon.png
!assets/preview.png

# ---- Not part of the website ----
# README.md, AUDIT.md, yandex*.html, scratch/test files stay local
